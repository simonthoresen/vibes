{
  "name": "3d-multiplayer-game",
  "version": "1.0.0",
  "description": "A 3D multiplayer game using Three.js, PeerJS, and Electron",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "game",
    "3d",
    "multiplayer",
    "threejs",
    "peerjs",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "peerjs": "^1.5.4",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.3dmultiplayergame.app",
    "productName": "3D Multiplayer Game",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!.gitignore"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
